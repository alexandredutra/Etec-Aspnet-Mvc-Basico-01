@{
    ViewBag.Title = "Ambiente de Testes";
    ViewBag.Message = "Prática de Desenvolvimento Web";
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>
    <h3>@ViewBag.Message</h3>

    <p>
        Esta é uma aplicação de teste desenvolvida para fins didáticos, criada para que os alunos
        possam praticar e validar seus conhecimentos em <strong>C#</strong>, <strong>ASP.NET</strong>
        e <strong>Razor</strong>. Utilize este ambiente para explorar a estrutura do projeto, testar novas
        funcionalidades e aplicar os conceitos vistos em aula.
    </p>
</main>